# Local Tesseract OCR is the default engine.
# Install German tessdata before using the default OCR language: deu+eng.

# Google Document AI OCR is a guarded legacy fallback.
# It is only used with: TODESANZEIGEN_ALLOW_GCP=1 todesanzeigen ocr --engine documentai
# TODESANZEIGEN_ALLOW_GCP=0
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
# DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_PROCESSOR_ID=your-document-ai-processor-id

# LLM extraction
# TODESANZEIGEN_LLM_PROVIDER=gemini

# Gemini extraction settings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Qwen extraction settings
# TODESANZEIGEN_LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-dashscope-api-key
# QWEN_MODEL=qwen3.6-flash
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Vision reroute settings for low-confidence OCR/name cases
# TODESANZEIGEN_REROUTE_PROVIDER=qwen
# TODESANZEIGEN_REROUTE_MODEL=qwen3.7-plus-2026-05-26
# TODESANZEIGEN_REROUTE_CONCURRENCY=1
# QWEN_VISION_MODEL=qwen3.7-plus-2026-05-26
# QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GEMINI_VISION_MODEL=gemini-2.5-pro
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_VISION_MODEL=gpt-5.6-luna

# Image-only vision extraction settings
# TODESANZEIGEN_VISION_PROVIDER=qwen
# TODESANZEIGEN_VISION_MODEL=qwen3.7-plus-2026-05-26
# TODESANZEIGEN_VISION_CONCURRENCY=1

# Optional async extraction controls
# TODESANZEIGEN_LLM_CONCURRENCY=1
# TODESANZEIGEN_LLM_RPM_LIMIT=600
# TODESANZEIGEN_LLM_TPM_LIMIT=500000
# TODESANZEIGEN_LLM_MAX_RETRIES=5

# Optional flat-source label for result.csv
TODESANZEIGEN_SOURCE=
